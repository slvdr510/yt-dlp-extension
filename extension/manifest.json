{
  "manifest_version": 3,
  "name": "yt-dlp-extension",
  "version": "0.1.0",
  "description": "Download videos, music and subtitles from YouTube and the other sites yt-dlp supports, running inside your browser.",
  "minimum_chrome_version": "137",
  "permissions": [
    "downloads",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "yt-dlp-extension",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "sandbox": {
    "pages": [
      "jsbox.html"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
