{
  "manifest_version": 3,
  "name": "yt-dlp spike",
  "version": "0.0.1",
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "sandbox": { "pages": ["jsbox.html"] },
